{
  "name": "@exam-anti-cheat/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron dist/main.js --use-dev-servers",
    "start": "npm run build:server && npm run build && electron dist/main.js",
    "build:server": "cd ../.. && npm run build --workspace @exam-anti-cheat/web && npm run build:bundle --workspace @exam-anti-cheat/api",
    "build": "tsc && node scripts/build-native.cjs",
    "pack:builder": "electron-builder --mac --x64",
    "pack:judge": "electron-builder --mac --x64 -c.extraMetadata.examJudgeBuild=true",
    "pack": "npm run build && npm run pack:builder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.8.0",
    "electron": "^44.4.1"
  },
  "build": {
    "appId": "com.exam-anti-cheat.desktop",
    "npmRebuild": false,
    "electronVersion": "44.4.1",
    "electronDist": "../../node_modules/electron/dist",
    "productName": "Exam Anti-Cheat",
    "extraResources": [
      {
        "from": "native-bin/app-control",
        "to": "app-control"
      },
      {
        "from": "../api/dist",
        "to": "api"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "native-bin/whisper",
        "to": "whisper"
      },
      {
        "from": "native-bin/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "entitlements": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app requires camera access to verify your identity during exams.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to monitor the testing environment.",
        "NSCameraUseContinuityCameraDeviceType": true,
        "LSMinimumSystemVersion": "13.0"
      },
      "identity": null,
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "minimumSystemVersion": "13.0",
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/native-bin/**"
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "dmg": {
      "title": "Exam Anti-Cheat"
    }
  },
  "allowScripts": {
    "electron@44.4.1": true
  },
  "dependencies": {}
}

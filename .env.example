# API server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/exam-anti-cheat.sqlite

# Auth
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local demo only; production configuration rejects enabling this route.
ENABLE_FRESH_EXAM_GENERATION=true

# Gemini AI (comma-separated, rotated round-robin)
# Get keys at: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEYS=your-key-1,your-key-2
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-exp-03-07

# Server-side OWL-ViT object detection (needs: pip install transformers Pillow torch)
ENABLE_BACKEND_VISION=false

# Whisper worker pool: parallel transcriptions and how many clips may wait
WHISPER_CONCURRENCY=2
WHISPER_MAX_QUEUE=8

# Audio retention (days before auto-delete, 0 = keep forever)
AUDIO_RETAIN_DAYS=30

# Liveness
LIVENESS_FLASH_THRESHOLD=8.0
LIVENESS_NOISE_THRESHOLD=3.0
LIVENESS_JITTER_THRESHOLD=0.15

# Demo seed
DEMO_STUDENT_EMAIL=demo.student@example.test
DEMO_STUDENT_PASSWORD=Demo exam password 2026!
DEMO_INSTRUCTOR_EMAIL=demo.instructor@example.test
DEMO_INSTRUCTOR_PASSWORD=Demo instructor password 2026!

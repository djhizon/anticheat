# API server
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/exam-anti-cheat.sqlite

# Auth
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local demo only; production configuration rejects enabling this route.
ENABLE_FRESH_EXAM_GENERATION=true

# Gemini AI (comma-separated, rotated round-robin)
# Get keys at: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEYS=your-key-1,your-key-2
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Tried in order when the primary is overloaded (503) or retired (404)
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Server-side OWL-ViT object detection (needs: pip install transformers Pillow torch)
ENABLE_BACKEND_VISION=false
# Optional: Python with transformers + torch (defaults to apps/api/vendor/venv)
VISION_PYTHON=

# Whisper worker pool: parallel transcriptions and how many clips may wait
WHISPER_CONCURRENCY=2
WHISPER_MAX_QUEUE=8
# Speech model (npm run setup:whisper downloads it; WHISPER_MODEL_PATH overrides the file):
#   small.en (default, ~190 MB, keeps up live on an Intel Mac CPU)
#   large-v3-turbo (~574 MB) or large-v3 (~1.1 GB): more accurate, Apple Silicon / fast CPUs only
#   base (~60 MB): low-end laptops
WHISPER_MODEL=small.en
# Spoken language: en (default) or another ISO code; auto re-enables detection
WHISPER_LANGUAGE=en
# Short decoding prompt that biases toward English speech; empty disables it
# WHISPER_PROMPT=Exam room. English speech.
# Optional speed-up: encoder frames (320-1499; 512 covers a 6 s clip). Unset = full 30 s window
# WHISPER_AUDIO_CTX=512
# Per-clip transcription timeout in ms
WHISPER_TIMEOUT_MS=60000

# Audio retention (days before auto-delete, 0 = keep forever)
AUDIO_RETAIN_DAYS=30

# Evidence snapshot retention (days before triggered still photos are auto-deleted, 0 = keep until the attempt is removed)
EVIDENCE_RETAIN_DAYS=30
# Both retention values are defaults: an exam's own retention setting (instructor privacy route) overrides them.
# Attempts a teacher marks "fine" lose their photos, transcripts and recording metadata 7 days later.

# Screen recording upload default for exams without their own setting: on = upload to OneDrive
# (needs MS_* settings), off = recordings stay on the student's computer and uploads are refused.
RECORDING_UPLOAD=on

# Liveness (HMAC secret for signing challenges; random per process if unset)
LIVENESS_SECRET=
LIVENESS_FLASH_THRESHOLD=8.0
LIVENESS_NOISE_THRESHOLD=3.0
LIVENESS_JITTER_THRESHOLD=0.15

# Demo seed
DEMO_STUDENT_EMAIL=demo.student@example.test
DEMO_STUDENT_PASSWORD=Demo exam password 2026!
DEMO_INSTRUCTOR_EMAIL=demo.instructor@example.test
DEMO_INSTRUCTOR_PASSWORD=Demo instructor password 2026!

# ngrok static domain used by `npm run share` (public URL, not a secret)
SHARE_HOST=

# Optional: Supabase Auth as identity provider (confirm sign-up, forgot/reset password,
# change password/email by email). Leave unset to use the local offline accounts.
# Placeholders below (anything containing "<") count as unset.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe to be public.
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Secret key (sb_secret_...) or legacy service_role JWT. Server-side only; used by the demo seed.
SUPABASE_SERVICE_ROLE_KEY=<secret-or-service-role-key>
# Public web origin used in email links (defaults to the first ALLOWED_ORIGINS entry)
SITE_URL=http://localhost:5173
